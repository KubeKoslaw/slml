slml 0.2
use"layout.slml"

@pair(html, slml){
  c{g0
    r{wrap g12 py8
      t{w:f nw240 "[$html]{mono c#8a3b12}"}
      t{w:f nw240 "[$slml]{mono c#14532d}"}
    }
    |{c#eeeef3}
  }
}

doc{$title"Coming from HTML"
  t.lead"SLML does what HTML and CSS do in a fraction of the characters, and without the parts that cause trouble. This page maps what you know to SLML."
  demo{$code"""
      c{bg#fff p20 r12 g8
        ##"Welcome"
        "Read *more* [here](/syntax.slml)."
      }
      """
    c{bg#fff p20 r12 g8
      ##"Welcome"
      "Read *more* [here](/syntax.slml)."
    }
  }
  "The same in HTML and CSS needs a `div` with a `style` (or a class in a separate stylesheet), an `h2`, a `p`, a `strong` and an `a`: about four times as many characters."
  section{$id"map" $title"Element by element"
    r{g12
      t{w:f b s14 "HTML"}
      t{w:f b s14 "SLML"}
    }
    c{g0
      pair{$html"<!DOCTYPE html>" $slml"slml 0.2"}
      pair{$html"<title>Home</title>" $slml"meta{\"Home\"}"}
      pair{$html"<body>…</body>" $slml"page{…}"}
      pair{$html"<div>, <main>, <aside>, <nav>, <section>" $slml"c{…} or r{…}"}
      pair{$html"<h1>Title</h1>" $slml"#\"Title\""}
      pair{$html"<h2>Title</h2>" $slml"##\"Title\""}
      pair{$html"<p>Text</p>" $slml"\"Text\""}
      pair{$html"<b>, <strong>" $slml"*text*"}
      pair{$html"<i>, <em>" $slml"_text_"}
      pair{$html"<code>" $slml"`text`"}
      pair{$html"<a href=\"x.html\">text</a>" $slml"[text](x.slml)"}
      pair{$html"<span style=\"color:red\">" $slml"[text]{c#f00}"}
      pair{$html"<img src=\"a.png\" alt=\"A\">" $slml"img{./a.png \"A\"}"}
      pair{$html"<ul><li>One</li></ul>" $slml"-{\"One\"}"}
      pair{$html"<ol>" $slml"+{…}"}
      pair{$html"<pre>" $slml"code\"…\""}
      pair{$html"<hr>" $slml"|"}
      pair{$html"<br>" $slml"\\n inside a string"}
      pair{$html"&amp; &lt; &nbsp;" $slml"just type & < and spaces"}
      pair{$html"<form action=… method=post>" $slml"form{>… post …}"}
      pair{$html"<label>Name <input name=n></label>" $slml"in{n:n \"Name\"}"}
      pair{$html"<button type=submit>" $slml"send\"Send\""}
      pair{$html"<table>" $slml"grid{colsN …} or rows"}
    }
  }
  section{$id"css" $title"CSS to attributes"
    c{g0
      pair{$html"display: flex; flex-direction: column" $slml"c{…}"}
      pair{$html"display: flex" $slml"r{…}"}
      pair{$html"flex-wrap: wrap" $slml"wrap"}
      pair{$html"grid-template-columns: repeat(3, 1fr)" $slml"grid{cols3 …}"}
      pair{$html"repeat(auto-fill, minmax(200px, 1fr))" $slml"grid{cw200 …}"}
      pair{$html"gap: 16px" $slml"g16"}
      pair{$html"align-items: center" $slml"a:c"}
      pair{$html"justify-content: space-between" $slml"j:b"}
      pair{$html"flex: 1" $slml"w:f"}
      pair{$html"max-width: 760px; margin: 0 auto" $slml"mw760 in a c{a:c …}"}
      pair{$html"padding: 8px 16px" $slml"py8 px16"}
      pair{$html"background: #fff" $slml"bg#fff"}
      pair{$html"border-radius: 12px" $slml"r12"}
      pair{$html"border: 1px solid #ddd" $slml"b1 bc#ddd"}
      pair{$html"box-shadow: …" $slml"sh:s / sh:l"}
      pair{$html"font-weight: bold" $slml"b"}
      pair{$html"font-size: 18px" $slml"s18"}
      pair{$html"color: #333" $slml"c#333"}
      pair{$html"text-align: center" $slml"a:c (on text)"}
      pair{$html".card { … } + class=\"card\"" $slml"@card{…} + c.card{…}"}
    }
  }
  section{$id"differences" $title"Things that work differently"
    -{g8
      "*No landmark elements.* There is no `main`, `aside`, `nav`, `header` or `section`, and no rules about which may contain which. A box is a box; place it wherever the layout needs it."
      "*No margins.* Space between elements is the parent's `g`. There are no collapsing margins to fight."
      "*No cascade.* A style applies only where you write `.name`. Only text properties (color, size, …) are inherited."
      "*No JavaScript.* SLML pages are documents. Exported sites contain no scripts, which also makes them fast and safe."
      "*Literal text.* Spaces and line breaks in strings are kept as written; only `*`, `_`, backticks and brackets format text."
      "*Errors instead of repairs.* See [Understanding errors](/errors.slml)."
    }
  }
  pager{$prev"/errors.slml" $prev-label"Understanding errors" $next"/reference.slml" $next-label"Reference"}
}
