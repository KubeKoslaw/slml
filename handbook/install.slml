slml 0.1

use "layout.slml"

doc(title: "Installing the compiler") {
  text.lead { "SLML is one program, " code "slml" ". It opens pages in SLML's own native browser and checks them for mistakes. You do not need Rust or any other tool to use it." }

  section(id: "prebuilt", title: "Prebuilt compiler") {
    text { bold "Linux and macOS:" " run the install script. It puts " code "slml" " into " code "~/.local/bin" "." }
    codeblock "curl -fsSL https://raw.githubusercontent.com/KubeKoslaw/slml/main/install.sh | sh"
    text { bold "Windows" " (PowerShell):" }
    codeblock "irm https://raw.githubusercontent.com/KubeKoslaw/slml/main/install.ps1 | iex"
    text { "You can also download an archive for your system from the " link(to: "https://github.com/KubeKoslaw/slml/releases") "releases page" " and put the " code "slml" " program anywhere on your " code "PATH" "." }
    note(title: "Private repository") {
      text { "While the SLML repository is private, downloads need a GitHub login. Install the GitHub CLI, run " code "gh auth login" ", and the install script will download through it." }
    }
  }

  section(id: "source", title: "Building from source") {
    text { "Install " link(to: "https://rustup.rs") "Rust" " 1.88 or newer, then build and install the native browser:" }
    codeblock """
        git clone https://github.com/KubeKoslaw/slml
        cd slml
        make install
        """
    text { code "make install" " copies " code "slml" " to " code "~/.local/bin" " and its manual page to " code "~/.local/share/man" ". For a system-wide install use " code "sudo make install PREFIX=/usr/local" ". On a server without a graphical desktop, add " code "VIEWER=0" " to leave out the native viewer window." }
  }

  section(id: "check", title: "Check that it works") {
    codeblock """
        slml --version
        slml --help
        """
    text "You should see the compiler version and the language version, for example:"
    codeblock "slml 0.1.0 (language 0.1)"
  }

  section(id: "editor", title: "Editor setup") {
    text { "Any text editor works. Save files as UTF-8 with the " code ".slml" " extension. Run " code "slml" " with your site folder, or run " code "slml index.slml" ": SLML's native browser reloads every time you save." }
  }

  pager(prev: "/index.slml", prev-label: "Introduction", next: "/first-page.slml", next-label: "Your first page")
}
