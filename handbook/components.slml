slml 0.1

use "layout.slml"

define badge(label, color: #2457d6) {
  text(fill: $color, color: #ffffff, size: 13, bold: true, padding-x: 10, padding-y: 3, radius: 99) $label
}

define feature(title) {
  column(fill: #ffffff, padding: 16, radius: 12, border: 1, border-color: #e4e4ea, gap: 6, width: fill) {
    heading(level: 4) $title
    slot
  }
}

doc(title: "Components and imports") {
  text.lead { "Components are your own elements. You define them once with " code "define" " and use them like built-in elements. Imports share them between files." }

  section(id: "define", title: "Defining a component") {
    demo(code: """
        define badge(label, color: #2457d6) {
          text(fill: $color, color: #ffffff, size: 13, bold: true,
               padding-x: 10, padding-y: 3, radius: 99) $label
        }

        row(gap: 8) {
          badge(label: "New")
          badge(label: "Sale", color: #c2410c)
        }
        """) {
      row(gap: 8) {
        badge(label: "New")
        badge(label: "Sale", color: #c2410c)
      }
    }
    list(gap: 6) {
      item { code "define name(param, other: default) { ... }" " declares a component. Parameters without a default are required." }
      item { "Inside the body, " code "$param" " is replaced by the value given when the component is used, either as an attribute value or as text." }
      item { "Forgetting a required parameter, giving an unknown one, or using a name of a built-in element are errors." }
    }
  }

  section(id: "slot", title: "Passing content with slot") {
    text { code "slot" " marks where the content written inside the component's braces goes:" }
    demo(code: """
        define feature(title) {
          column(fill: #ffffff, padding: 16, radius: 12, border: 1,
                 border-color: #e4e4ea, gap: 6, width: fill) {
            heading(level: 4) $title
            slot
          }
        }

        row(gap: 12) {
          feature(title: "Fast") { text "Compiles in milliseconds." }
          feature(title: "Strict") { text "No silent mistakes." }
        }
        """) {
      row(gap: 12) {
        feature(title: "Fast") { text "Compiles in milliseconds." }
        feature(title: "Strict") { text "No silent mistakes." }
      }
    }
    text "Components can use other components. A component is replaced by its content before the page is checked, so everything it produces is validated like hand-written SLML."
  }

  section(id: "layouts", title: "Page layouts") {
    text { "A component can produce the whole " code "meta" " and " code "page" ". Then every page of a site is just its content:" }
    codeblock """
        // layout.slml
        slml 0.1

        define site-page(title) {
          meta(title: $title, lang: "en")
          page(padding: 0, gap: 0) {
            menu
            column(padding: 32, gap: 16) {
              heading $title
              slot
            }
            footer
          }
        }
        """
    codeblock """
        // about.slml
        slml 0.1
        use "/layout.slml"

        site-page(title: "About us") {
          text "We make things."
        }
        """
    text { "This handbook works exactly like that: look at " code "handbook/layout.slml" " in the repository." }
  }

  section(id: "imports", title: "Imports") {
    text { code "use \"file.slml\"" " loads the " code "style" "s and " code "define" "s of another file. An imported file contains no " code "meta" " or " code "page" "; it is a " bold "library" ", and " code "slml build site/" " does not turn it into a page." }
    list(gap: 6) {
      item { "Paths work like links: relative to the file, or from the site root with " code "/" "." }
      item { "Libraries can import other libraries. Each file is loaded once, and import loops are errors." }
      item { "Errors in an imported file are reported with that file's name and line." }
    }
  }

  pager(prev: "/links.slml", prev-label: "Links and navigation", next: "/forms.slml", next-label: "Forms")
}
