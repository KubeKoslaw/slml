slml 0.2
// Shared styles and components for every handbook page.
// This file has no `page`, so `slml build handbook/` treats it as a library.
@lead{s18 c#3f3f4e}
@muted{c#5b5b70}
@small{s14 c#5b5b70}
@navlink{c#2b2b38 u:0}
@section{g12 py6}
@tile{bg#fff p18 r12 b1 bc#e6e6ee g6}

// One entry in the sidebar.
@nav(to, label){
  t{s15 "[$label]($to){.navlink}"}
}

// The frame of every page: top bar, sidebar, content, footer.
@doc(title, description"The SLML handbook: learn the Strict Layout Markup Language"){
  meta{$title desc$description lang:en icon/logo.png}
  page{bg#fbfbfd p0 g0
    r{bg#fff px24 py12 a:c g12 b1 bc#e6e6ee
      img{/logo.png w28 r7 >/index.slml "SLML home"}
      t{b s17 "[SLML Handbook](/index.slml){.navlink}"}
      ~
      t{s14 "[Reference](/reference.slml)"}
      t{s14 "[GitHub](https://github.com/KubeKoslaw/slml)"}
    }
    r{wrap a:s
      c{w260 px24 py28 g7
        t{s12 b c#8a8a99 "GETTING STARTED"}
        nav{$to"/index.slml" $label"Introduction"}
        nav{$to"/install.slml" $label"Installing the compiler"}
        nav{$to"/first-page.slml" $label"Your first page"}
        ~{h10}
        t{s12 b c#8a8a99 "THE LANGUAGE"}
        nav{$to"/syntax.slml" $label"Syntax basics"}
        nav{$to"/text.slml" $label"Text"}
        nav{$to"/layout-guide.slml" $label"Layout"}
        nav{$to"/styling.slml" $label"Boxes and styles"}
        nav{$to"/content.slml" $label"Lists, code and images"}
        nav{$to"/links.slml" $label"Links and navigation"}
        nav{$to"/components.slml" $label"Components and imports"}
        nav{$to"/forms.slml" $label"Forms"}
        ~{h10}
        t{s12 b c#8a8a99 "WEBSITES"}
        nav{$to"/sites.slml" $label"Building a website"}
        nav{$to"/website-tutorial.slml" $label"A complete website"}
        nav{$to"/cli.slml" $label"Command line"}
        nav{$to"/errors.slml" $label"Understanding errors"}
        nav{$to"/from-html.slml" $label"Coming from HTML"}
        nav{$to"/reference.slml" $label"Reference"}
      }
      c{w:f nw320 px32 py36 a:c
        c{w:f mw760 g20
          #$title
          slot
          |{c#e6e6ee}
          t.small"SLML handbook · written in SLML and built with `slml handbook/` · [source on GitHub](https://github.com/KubeKoslaw/slml)"
        }
      }
    }
  }
}

// A highlighted remark.
@note(title"Note"){
  c{bg#eef3ff p16 r10 g6 b1 bc#d6e0fb
    t{b s14 c#2944a8 $title}
    slot
  }
}

@warning(title"Watch out"){
  c{bg#fff6e8 p16 r10 g6 b1 bc#f5ddb0
    t{b s14 c#8a5300 $title}
    slot
  }
}

// Source code followed by what it renders.
@demo(code){
  c{b1 bc#e6e6ee r12 bg#fff
    code{r0 bg#f6f6fa $code}
    c{p18 g10
      t{s12 b c#8a8a99 "RESULT"}
      slot
    }
  }
}

// A section with an anchor and a level-2 heading.
@section(id, title){
  c.section{id$id
    ##$title
    slot
  }
}

// A row of a reference table: name, accepted values, description.
@ref(name, values, about){
  c{g0
    r{wrap g12 py9
      t{w150 "[$name]{mono b}"}
      t{w210 s14 c#3f3f4e $values}
      t{w:f nw220 s15 $about}
    }
    |{c#eeeef3}
  }
}

// Previous / next links at the bottom of a chapter.
@pager(prev, prev-label, next, next-label){
  r{g12 py8
    btn{>$prev bg#fff c#2b2b38 b1 bc#d8d8e2 $prev-label}
    ~
    btn{>$next $next-label}
  }
}
