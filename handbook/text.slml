slml 0.2
use"layout.slml"

doc{$title"Text"
  t.lead"Text is written in strings. A bare string in a box is a paragraph; headings, buttons and list items take strings too. Inside a string, a few characters format the text."
  section{$id"blocks" $title"Paragraphs and headings"
    demo{$code"""
        #"Level 1 heading"
        ##"Level 2 heading"
        ###"Level 3 heading"
        ####"Level 4 heading"
        "A paragraph wraps automatically when the line is full."
        t{s14 c#5b5b70 "A paragraph with attributes needs t."}
        """
      #"Level 1 heading"
      ##"Level 2 heading"
      ###"Level 3 heading"
      ####"Level 4 heading"
      "A paragraph wraps automatically when the line is full."
      t{s14 c#5b5b70 "A paragraph with attributes needs t."}
    }
    "Several strings in one text are joined without spaces: `t{\"Hello, \" \"world\"}` is `Hello, world`. Use it to split long text over several lines of source."
  }
  section{$id"inline" $title"Formatting inside text"
    demo{$code"""
        "You can make text *bold*, _italic_, `monospaced`,
        [orange]{c#c2410c}, [big]{s22 b} or a [link](#inline)."
        """
      "You can make text *bold*, _italic_, `monospaced`, [orange]{c#c2410c}, [big]{s22 b} or a [link](#inline)."
    }
    c{g0
      ref{$name"*text*" $values"bold" $about"Bold."}
      ref{$name"_text_" $values"italic" $about"Italic."}
      ref{$name"`text`" $values"code" $about"Monospaced and literal: no formatting inside."}
      ref{$name"[text](target)" $values"link" $about"A link; see Links and navigation."}
      ref{$name"[text]{attrs}" $values"styled text" $about"Any text attributes for part of a sentence: [sale]{c#c2410c b}."}
      ref{$name"[text](target){.style}" $values"styled link" $about"A link with attributes or a style."}
    }
    "Formatting can be nested: `*bold and _italic_*`. Write `\\*`, `\\_`, `\\\``, `\\[` or `\\]` for the characters themselves."
  }
  section{$id"attributes" $title"Text attributes"
    "These attributes work on any element and are inherited by everything inside it:"
    c{g0
      ref{$name"c#333" $values"color" $about"Text color."}
      ref{$name"s18" $values"number" $about"Font size in pixels. The page default is 16."}
      ref{$name"b  i  u" $values"flags" $about"Bold, italic, underlined. b:0, i:0, u:0 switch an inherited value off."}
      ref{$name"mono  sans" $values"flags" $about"The bundled Noto Sans Mono or Noto Sans."}
    }
    demo{$code"""
        c{c#2944a8 s18
          "Blue and larger"
          t{b "Also blue, and bold"}
        }
        """
      c{c#2944a8 s18
        "Blue and larger"
        t{b "Also blue, and bold"}
      }
    }
    demo{$code"""
        c{mono g8
          "This paragraph inherits the monospace font."
          t{sans "This paragraph switches back to sans."}
        }
        """
      c{mono g8
        "This paragraph inherits the monospace font."
        t{sans "This paragraph switches back to sans."}
      }
    }
  }
  section{$id"align" $title"Alignment and line breaks"
    demo{$code"""
        t{a:c "Centered"}
        t{a:e "Right aligned"}
        "Line one\nLine two"
        """
      t{a:c "Centered"}
      t{a:e "Right aligned"}
      "Line one\nLine two"
    }
    note{$title"Whitespace is never collapsed"
      "Unlike HTML, two spaces are two spaces and a line break is written as \\n. What you write is what you see."
    }
  }
  section{$id"selection" $title"Selecting and copying"
    "In the optional web preview (slml serve --web) and Firefox extension, drag across text to select it and press `Ctrl+C` (`Cmd+C` on macOS) to copy. `Ctrl+A` selects the document when you are not editing a field or the source."
    "Copying keeps literal spaces, code indentation and explicit newlines. A line wrapped only to fit the screen remains part of the same paragraph; separate text blocks are joined by a newline. Editable form fields keep their normal browser selection and copy behavior."
    "The native browser selects text the same way: drag, double-click for a word, triple-click for a paragraph, Shift+click to extend, Ctrl+A for everything and Ctrl+C to copy. On Linux, copying uses wl-clipboard or xclip."
  }
  section{$id"symbols" $title"Symbols and emoji"
    "The bundled fonts cover Latin, Greek and Cyrillic, symbols, arrows, math and monochrome emoji: ★ ✓ → ∑ ♥ 😀. Pages look the same on every computer because the fonts travel with them."
  }
  pager{$prev"/syntax.slml" $prev-label"Syntax basics" $next"/layout-guide.slml" $next-label"Layout"}
}
