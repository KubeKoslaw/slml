slml 0.1

use "layout.slml"

doc(title: "Syntax basics") {
  text.lead "SLML has one simple shape for everything: a name, optional attributes in parentheses, and either a text label or a block of content in braces."

  section(id: "elements", title: "Elements") {
    codeblock """
        name                          // just the name
        name(attribute: value)        // with attributes
        name "label"                  // with a text label
        name(attribute: value) {      // with a block of content
          child
          child
        }
        """
    text { "A label is a short form of a block with one string: " code "text \"Hi\"" " means the same as " code "text { \"Hi\" }" ". An element takes a label " italic "or" " a block, never both." }
  }

  section(id: "attributes", title: "Attributes") {
    text { "Attributes are written " code "name: value" " inside parentheses. Commas between them are optional, so long lists can be written one per line:" }
    codeblock """
        column(
          padding: 24
          fill: #ffffff
          radius: 12
        ) { text "Card" }
        """
    text "A value is one of:"
    column(gap: 0) {
      ref(name: "16", values: "number", about: "Pixels, sizes, counts. No units are written.")
      ref(name: "\"Hello\"", values: "string", about: "Text in double quotes.")
      ref(name: "#2457d6", values: "color", about: "Hex: #rgb, #rgba, #rrggbb or #rrggbbaa. There are no color names.")
      ref(name: "center", values: "name", about: "One of the words an attribute accepts, such as center, fill or true.")
    }
    text { "Every attribute is checked: an unknown name, a value of the wrong kind or an attribute the element doesn't accept is an error." }
  }

  section(id: "strings", title: "Strings") {
    text { "Strings are " bold "literal" ": what you write is what you get. Spaces are kept, and there are no entities like " code "&amp;" "." }
    list(gap: 6) {
      item { code "\\n" " starts a new line, " code "\\t" " is a tab, " code "\\\"" " is a quote and " code "\\\\" " is a backslash." }
      item { code "\\u{1F600}" " is any Unicode character by its number." }
      item { "A normal string must end on the same line." }
    }
    text { "For longer text, especially code, use a " bold "block string" " between triple quotes. Nothing inside it is escaped, and the indentation of the closing " code "\"\"\"" " is removed from every line:" }
    codeblock "codeblock \"\"\"\n    first line\n      indented line\n    \"\"\""
  }

  section(id: "comments", title: "Comments and whitespace") {
    codeblock """
        // a comment until the end of the line
        /* a comment
           over several lines */
        """
    text "Spaces, tabs and line breaks between elements have no meaning. Indent however you like: re-formatting a file never changes the page."
  }

  section(id: "structure", title: "File structure") {
    codeblock """
        slml 0.1                         // version line, always first

        use "layout.slml"                // imports (optional)
        style card(padding: 16)          // styles (optional)
        define badge(label) { ... }      // components (optional)

        meta(title: "Page title")        // page information (optional)
        page { ... }                     // the page itself
        """
  }

  pager(prev: "/first-page.slml", prev-label: "Your first page", next: "/text.slml", next-label: "Text")
}
