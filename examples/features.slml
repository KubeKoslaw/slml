slml 0.2
// A tour of SLML features: components, lists, grid, wrapping rows,
// anchors, code blocks and forms.
@muted{c#5b5b66}

@section(id, title){
  c{id$id g12 py8
    ##$title
    slot
  }
}

@feature(title, icon"★"){
  c{bg#fff p18 r12 b1 bc#e4e4ea g6 sh:s
    t{s22 $icon}
    ####$title
    slot
  }
}

meta{"SLML features" desc"Everything SLML 0.1 can do on one page"}

page{bg#f6f6f9 a:c
  c{w:f mw900 g28
    c{g8
      #"SLML features"
      t.muted"Jump to: [lists](#lists), [grid](#grid), [code](#code), [form](#form)."
    }
    section{$id"lists" $title"Lists"
      r{wrap g24
        -{w:f nw240
          "Bullets by default"
          "Inline *formatting* works"
          +{"Nested lists" "count separately"}
        }
        +{w:f nw240 "Write a page" "Run `slml page.slml`" "Open page.html"}
      }
    }
    section{$id"grid" $title"Responsive grid"
      t.muted"Cells are at least 200 pixels wide; narrow windows get fewer columns."
      grid{cw200 g16
        feature{$title"Strict" $icon"✓" t.muted"Errors, not guesses."}
        feature{$title"Fast" t.muted"One pass, no backtracking."}
        feature{$title"Portable" t.muted"Fonts are bundled."}
        feature{$title"Reusable" t.muted"Components with slots."}
      }
    }
    section{$id"code" $title"Code blocks"
      code"""
          define card(title) {
            column(padding: 20, radius: 12) {
              heading $title
              slot
            }
          }
          """
    }
    section{$id"form" $title"Forms"
      form{>https://example.com/contact post bg#fff p24 r12 mw520
        in{n:name "Your name" ph"Ann Smith" req}
        in{n:email "E-mail" k:email ph"ann@example.com" req}
        sel{n:topic "Topic" opt"Question" opt{on "Feedback"} opt"Other"}
        area{n:message "Message" rows4}
        check{n:copy "Send me a copy" on}
        r{send"Send message"}
      }
    }
    |
    t{s14 "[Back to top](#lists) · [hello@example.com](mailto:hello@example.com)"}
  }
}
