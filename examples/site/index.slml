slml 0.2
// Reusable styles: named attribute sets, applied with `.name`.
@card{bg#fff p20 r12 b1 bc#e4e4ea g8 w:f}
@muted{c#5b5b66}
@pill{bg#eef2ff c#2944a8 px10 py4 r99 s13}

meta{"SLML — a stricter web" lang:en}

page{bg#f6f6f9 p0 g0
  // Top bar
  r{bg#fff px32 py14 a:c g12 b1 bc#e4e4ea
    img{./logo.png w32 r8 "SLML logo"}
    t{b s18 "SLML"}
    ~
    "[Home](index.slml)"
    "[Why not HTML?](about.slml)"
  }
  // Content, centered and limited in width
  c{p32 a:c
    c{w:f mw880 g24
      c{g12 py24
        r{t.pill"version 0.1 — experimental"}
        #{s40 "Documents without the guesswork"}
        t.muted{s18 "SLML is a small, strict language for documents and interfaces, with its own renderer written in Rust. One syntax for structure _and_ style, layout built in, and errors instead of silent guessing."}
        r{g12 py8
          btn{>about.slml "Why not HTML?"}
          btn{>index.slml bg#fff c#1b1b1f b1 bc#d4d4d8 "Reload"}
        }
      }
      r{g16
        c.card{
          ###"Strict"
          t.muted"Unknown elements, misspelled attributes and missing alt texts are errors with line numbers — never silently ignored."
        }
        c.card{
          ###"Layout first"
          t.muted"`row`, `column`, `fill` and `gap` are part of the language. No floats, no hacks."
        }
        c.card{
          ###"One syntax"
          t.muted"Structure, style and reusable styles share one grammar. Nothing to switch between."
        }
      }
      c.card{g12
        ##"What it looks like"
        t{mono s14 bg#f6f6f9 p16 r8 "slml 0.1\n\nstyle card(padding: 20, radius: 12, fill: #ffffff)\n\npage {\n  heading \"Hello\"\n  row(gap: 16) {\n    column.card { text \"Left\" }\n    column.card(width: fill) { text \"Right\" }\n  }\n}"}
      }
      |
      r{a:c
        t.muted{s14 "Made with *SLML* · MIT OR Apache-2.0"}
        ~
        t{s14 "[Read the design notes](about.slml)"}
      }
    }
  }
}
