slml 0.2
use"layout.slml"

site{$title"About — Fieldwork" $description"How the fictional Fieldwork studio approaches a website project."
  c{g16 mw720
    t{s13 b c#176b52 "ABOUT THE STUDIO"}
    #"Useful things, made together."
    t.muted{s20 "Fieldwork is a fictional independent studio. Replace this story with your own when you use the starter."}
    "We believe a website should help people understand what you do and how to get in touch. Our process keeps those two needs at the centre."
  }
  c.card{
    ##"How a project works"
    +{g12
      "*Listen.* We start with your audience, goals and existing content."
      "*Build.* We turn that into a shared layout and a small set of clear pages."
      "*Refine.* We test navigation, forms and small screens together."
      "*Publish.* You receive the files and instructions to keep the site up to date."
    }
  }
  r{wrap g12
    btn.action{>contact.slml "Tell us about your idea"}
    btn{>index.slml bg#fff c#173b35 "Back to home"}
  }
}
