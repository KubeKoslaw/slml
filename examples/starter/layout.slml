slml 0.2
@muted{c#536260}
@nav{c#173b35 u:0}
@card{bg#fff b1 bc#dbe5df p24 r14 g12}
@action{bg#176b52 r8}

@site(title, description){
  meta{$title desc$description lang:en}
  page{p20 g28 bg#f5f7f2 c#173b35 a:c
    c{w:f mw1040 g32
      r{wrap g20 a:c j:b
        t{s22 b "[FIELDWORK / STUDIO](index.slml){.nav}"}
        r{wrap g20 a:c
          "[Services](index.slml#services){.nav}"
          "[About](about.slml){.nav}"
          "[Contact](contact.slml){.nav}"
        }
      }
      |{c#ccd9d0}
      slot
      |{c#ccd9d0}
      r{wrap g12 j:b
        t.muted{s14 "Fieldwork is a fictional studio. This is an SLML starter."}
        t{s14 "[Try the form](contact.slml)"}
      }
    }
  }
}

@service(number, title){
  c.card{
    t{s13 b c#176b52 $number}
    ###$title
    slot
  }
}
