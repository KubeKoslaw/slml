slml 0.2
use"layout.slml"

site{$title"Fieldwork — thoughtful websites" $description"A complete responsive SLML website starter for a small studio."
  c{g20 py24
    t{s13 b c#176b52 "SMALL STUDIO. CLEAR IDEAS."}
    #{s44 mw700 "A good website starts with a clear story."}
    t.muted{s20 mw680 "We help independent teams turn what they do into a useful, welcoming place on the web. Built with care, from the first sketch to the final page."}
    r{wrap g12 a:c
      btn.action{>contact.slml "Start a conversation"}
      btn{>#services bg#fff c#173b35 b1 bc#ccd9d0 "Explore our services"}
    }
  }
  c{id:services g16
    ##"From an idea to a working website"
    grid{cols3 cw260 g16
      service{$number"01 / DIRECTION" $title"Make it clear"
        t.muted"Find the right words, choose the important pages and give every visitor a clear next step."
      }
      service{$number"02 / DESIGN" $title"Make it welcoming"
        t.muted"Readable type, useful navigation and layouts that fit both a phone and a wide screen."
      }
      service{$number"03 / DELIVERY" $title"Make it work"
        t.muted"A fast static site with accessible content, checked links and a straightforward publishing workflow."
      }
    }
  }
  c.card{g16
    ##"A small team, with you all the way"
    t.muted"You work directly with the people making your website. We keep decisions visible and the process simple."
    "[Meet the studio →](about.slml)"
  }
}
